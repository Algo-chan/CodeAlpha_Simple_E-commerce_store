{
  "name": "@ecommerce/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express.js REST API for the e-commerce platform",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch src --watch server.js server.js",
    "db:create": "node scripts/create-database.js",
    "migrate": "node migrations/run.js up",
    "migrate:status": "node migrations/run.js status",
    "seed": "node seeds/run.js",
    "test": "node --test --test-reporter=spec tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  }
}
