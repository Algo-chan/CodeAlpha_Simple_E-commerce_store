# ---------------------------------------------------------------------------
# Environment configuration template
#
# Copy this file to `.env` (repo root) and fill in real values:
#   cp .env.example .env                 (macOS / Linux / Git Bash)
#   Copy-Item .env.example .env          (PowerShell)
#
# `.env` is git-ignored and must NEVER be committed. In production, set every
# value through the hosting platform's secret manager / environment panel — do
# not upload a `.env` file to the server or bake secrets into an image.
#
# See docs/deployment.md for the full production walkthrough.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# production | development | test. `production` turns on the strict CSP, the
# Secure cookie flag, generic error messages and the production fail-fast checks.
NODE_ENV=development
PORT=4000

# Allowed frontend origin(s) for CORS. Comma-separated for multiple origins.
# In production this MUST be the exact HTTPS origin that serves the storefront,
# e.g. https://shop.example.com — never `*` and never a localhost URL.
FRONTEND_URL=http://localhost:5500,http://localhost:5173,http://localhost:3000

# The deployment's own public origin. Same-origin requests carry an `Origin`
# header (even for writes), so the origin the app is served from must be
# allowed. On Render this is unnecessary: RENDER_EXTERNAL_URL is injected
# automatically and trusted. Set PUBLIC_ORIGIN when fronting the site with a
# custom domain, e.g. https://shop.example.com.
PUBLIC_ORIGIN=

# --- Database (PostgreSQL) -------------------------------------------------
# Prefer DATABASE_URL on managed hosts (Render/Railway/Neon/Supabase/RDS); it
# carries TLS and credentials in one value. When it is set it WINS: `pg` merges
# the parsed URL over the parts below, so leave it empty to configure them
# individually.
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/ecommerce_store

# ...or the individual parts. Ignored while DATABASE_URL is set.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=ecommerce_store
# Set DB_SSL=true for any managed/hosted database. Keep DB_SSL_REJECT_UNAUTHORIZED
# at true in production unless your provider requires a self-signed certificate —
# Render's internal Postgres connections use self-signed certs, so they need it
# false (see render.yaml).
DB_SSL=false

# Connection pool tuning. DB_POOL_MAX should stay well below the database's
# connection ceiling; with several app instances, sum(pool max) < max_connections.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL_REJECT_UNAUTHORIZED=false

# --- Authentication --------------------------------------------------------
# Auth uses opaque server-side sessions (the `ecom_session` cookie), not JWTs.
# JWT_* is reserved for a future stateless surface but is still validated in
# production: the schema fails fast unless JWT_SECRET is >= 32 chars. Generate
# strong values and store them in the platform secret manager.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing (bcrypt rounds). 12 is a good production default.
BCRYPT_SALT_ROUNDS=12

# Server-side session cookie lifetime (hours). Default 168 = 7 days.
SESSION_TTL_HOURS=168

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Authenticated writes (review submit, password change).
WRITE_RATE_LIMIT_MAX=60
# Type-ahead search (can fire per keystroke, so deliberately generous).
SEARCH_RATE_LIMIT_MAX=200

# --- Online payments -------------------------------------------------------
# Which gateway handles ONLINE checkout. NONE disables online payment (COD
# only); MOCK is the built-in sandbox that issues fake intents and signed
# webhooks until real credentials exist.
# NOTE: only NONE and MOCK have adapters today. A real provider name is accepted
# by the schema but cannot go online until its adapter is registered in
# src/payments/index.js — see docs/deployment.md.
PAYMENT_PROVIDER=MOCK
# HMAC secret used to sign/verify provider webhooks. REQUIRED (16+ chars) in
# production whenever PAYMENT_PROVIDER is not NONE. Never commit a real value.
PAYMENT_WEBHOOK_SECRET=replace_with_a_long_random_string
# Reject a signed notification whose timestamp is older than this many seconds.
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Where the MOCK provider sends a shopper to "approve" a payment.
PAYMENT_MOCK_CHECKOUT_URL=http://localhost:4000/api/v1/payments/mock/checkout
# Minutes a PENDING online payment may sit before it is expired as timed out.
PAYMENT_PENDING_TIMEOUT_MINUTES=30

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error | silent. Use `info` in production.
LOG_LEVEL=debug

# --- Frontend --------------------------------------------------------------
# Public base URL of the API. Used to build the production CSP `connect-src`
# and (when injecting a runtime config) the storefront's `apiBaseUrl`. When the
# backend serves the frontend on the same origin, the storefront defaults to
# `<origin>/api/v1` and this only needs a value for split-host deployments.
API_BASE_URL=http://localhost:4000/api/v1

# --- Container bootstrap ---------------------------------------------------
# Read only by the Dockerfile's start command, never by the application. When
# `true`, the container loads `backend/seeds/` (demo users, products, orders)
# after migrations and before it starts serving. The seeds converge, so a
# restart is a cheap no-op.
#
# This exists for platforms that offer no way to run the seed runner by hand:
# Render's free plan has neither Shell nor one-off jobs. Leave it unset (or
# false) to deploy an empty catalogue and seed deliberately.
SEED_DEMO_DATA=false
