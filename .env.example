# ---------------------------------------------------------------------------
# Environment configuration template
#
# Copy this file to `.env` (repo root) and fill in real values.
# `.env` is git-ignored and must NEVER be committed.
#
#   cp .env.example .env     (macOS / Linux / Git Bash on Windows)
#   Copy-Item .env.example .env   (PowerShell)
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Allowed frontend origin(s) for CORS. Comma-separated for multiple origins.
FRONTEND_URL=http://localhost:5500,http://localhost:5173,http://localhost:3000

# --- Database (PostgreSQL) -------------------------------------------------
# Either provide DATABASE_URL...
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/ecommerce_store

# ...or the individual parts below (they override DATABASE_URL when present).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=ecommerce_store
DB_SSL=false

# Connection pool tuning
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL_REJECT_UNAUTHORIZED=false

# --- Authentication (used when auth is implemented) -----------------------
# Generate a strong value:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing (bcrypt rounds)
BCRYPT_SALT_ROUNDS=12

# Server-side session cookie lifetime (hours). Default 168 = 7 days.
SESSION_TTL_HOURS=168

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=debug

# --- Frontend (optional, only needed for a static build) -------------------
API_BASE_URL=http://localhost:4000/api/v1